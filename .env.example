# =============================================================================
# DiaLong-AutoML — environment variable template
# Copy to .env and fill in real values.  Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
DIALONG_ENV=development           # development | staging | production
DIALONG_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Override the default config file path (optional)
# DIALONG_CONFIG_PATH=configs/demo_fast.yaml

# ---------------------------------------------------------------------------
# Data paths (override pyproject defaults when running outside the repo root)
# ---------------------------------------------------------------------------
# DIALONG_DATA_DIR=/absolute/path/to/data
# DIALONG_ARTIFACTS_DIR=/absolute/path/to/artifacts
# DIALONG_OUTPUTS_DIR=/absolute/path/to/outputs
# DIALONG_LOGS_DIR=/absolute/path/to/logs

# ---------------------------------------------------------------------------
# Reproducibility
# ---------------------------------------------------------------------------
DIALONG_SEED=42

# ---------------------------------------------------------------------------
# Optuna storage (Phase 3+)
# ---------------------------------------------------------------------------
# Use a persistent backend to resume studies across runs.
# OPTUNA_STORAGE=sqlite:///artifacts/optuna.db
# OPTUNA_STORAGE=postgresql://user:password@localhost:5432/dialong_optuna

# ---------------------------------------------------------------------------
# API (Phase 5+)
# ---------------------------------------------------------------------------
# DIALONG_API_HOST=0.0.0.0
# DIALONG_API_PORT=8000
# DIALONG_API_WORKERS=1
# DIALONG_API_SECRET_KEY=change-me-before-production

# ---------------------------------------------------------------------------
# Database (Phase 5+)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/dialong

# ---------------------------------------------------------------------------
# External services (fill in when integrating)
# ---------------------------------------------------------------------------
# MLFLOW_TRACKING_URI=http://localhost:5000
# WANDB_API_KEY=
# WANDB_PROJECT=dialong-automl
